    {
      "cell_type": "code",
      "source": [
        "# Fix for packaging compatibility issue and conflicting setuptools\n",
        "!pip uninstall packaging -y\n",
        "!pip install packaging==20.9 --quiet # Rasa needs <21.0\n",
        "!pip uninstall setuptools -y\n",
        "!pip install setuptools==58.0.4 --quiet # To avoid ModuleNotFoundError: No module named 'packaging.markers'\n",
        "\n",
        "import rasa\n",
        "from rasa.model_testing import test\n",
        "import os\n",
        "\n",
        "def run_regression_tests(\n",
        "    model_path=\"models\",\n",
        "    test_data_path=\"tests\",\n",
        "    results_path=\"results\"\n",
        "):\n",
        "    # Create folder if missing\n",
        "    os.makedirs(results_path, exist_ok=True)\n",
        "\n",
        "    print(\"Running Rasa regression tests...\")\n",
        "    print(f\"Model: {model_path}\")\n",
        "    print(f\"Test data: {test_data_path}\")\n",
        "\n",
        "    # Rasa 3.x/4.x supported API\n",
        "    test(\n",
        "        model=model_path,\n",
        "        stories=test_data_path,\n",
        "        nlu_data=test_data_path,\n",
        "        output=results_path\n",
        "    )\n",
        "\n",
        "    print(\"\\n✔ Regression tests completed successfully!\")\n",
